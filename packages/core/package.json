{
  "name": "@scanly/core",
  "version": "2.1.0",
  "description": "Framework-independent barcode scanning contracts, router, sessions, tracking, batch, and recovery for Scanly SDK",
  "keywords": ["barcode", "qr-code", "scanner", "typescript", "tracking", "scanly"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangjunjie-Lin/Scanly.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Yangjunjie-Lin/Scanly#readme",
  "bugs": {
    "url": "https://github.com/Yangjunjie-Lin/Scanly/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "import": "./dist/qr/index.js"
    },
    "./barcode": {
      "types": "./dist/barcode/index.d.ts",
      "import": "./dist/barcode/index.js"
    },
    "./industrial": {
      "types": "./dist/industrial/index.d.ts",
      "import": "./dist/industrial/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@scanly/parsers": "2.1.0",
    "@scanly/scenario-schema": "2.1.0"
  }
}
